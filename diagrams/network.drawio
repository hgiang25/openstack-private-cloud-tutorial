flowchart LR

%%========================
%% STYLE DEFINITIONS
%%========================

classDef internet fill:#1565C0,stroke:#0D47A1,color:#fff,stroke-width:3px
classDef provider fill:#64B5F6,stroke:#1976D2,color:#fff,stroke-width:2px
classDef controller fill:#7E57C2,stroke:#4527A0,color:#fff,stroke-width:2px
classDef compute fill:#43A047,stroke:#1B5E20,color:#fff,stroke-width:2px
classDef storage fill:#8D6E63,stroke:#4E342E,color:#fff,stroke-width:2px
classDef monitor fill:#EC407A,stroke:#AD1457,color:#fff,stroke-width:2px
classDef tenant fill:#81C784,stroke:#2E7D32,color:#000,stroke-width:2px
classDef overlay fill:#FFB74D,stroke:#EF6C00,color:#000,stroke-width:2px
classDef mgmt fill:#BA68C8,stroke:#6A1B9A,color:#fff,stroke-width:2px

%%========================
%% INTERNET
%%========================

Internet((🌍 Internet))
ISP[📡 ISP Router]

Internet --> ISP

class Internet,ISP internet

%%========================
%% PROVIDER NETWORK
%%========================

subgraph EXT["🌐 Provider Network"]
GW[Gateway<br/>192.168.1.1]
end

ISP --> GW

class GW provider

%%========================
%% CONTROLLER
%%========================

subgraph CTRL["🖥 Controller Node"]

Horizon["🎛 Horizon"]

Keystone["🔐 Keystone"]

Nova["💻 Nova API"]

Neutron["🌐 Neutron Server"]

Router["🔀 Virtual Router"]

DHCP["📮 DHCP"]

Metadata["📋 Metadata"]

end

GW --> Router

class Horizon,Keystone,Nova,Neutron,Router,DHCP,Metadata controller

%%========================
%% VXLAN
%%========================

subgraph VX["🟧 Overlay Network"]

VXLAN["VXLAN Tunnel<br/>VNI 1001"]

end

Router ==> VXLAN

class VXLAN overlay

%%========================
%% COMPUTE
%%========================

subgraph C1["💻 Compute Node 01"]

Bridge1["Linux Bridge"]

Tap1["tap0"]

VM1["Ubuntu VM"]

Bridge1 --> Tap1 --> VM1

end

subgraph C2["💻 Compute Node 02"]

Bridge2["Linux Bridge"]

Tap2["tap0"]

VM2["Ubuntu VM"]

Bridge2 --> Tap2 --> VM2

end

VXLAN ==> Bridge1
VXLAN ==> Bridge2

class Bridge1,Bridge2 compute
class VM1,VM2 tenant

%%========================
%% STORAGE
%%========================

subgraph ST["💾 Storage Node"]

Cinder["Cinder Volume"]

Swift["Swift"]

end

class Cinder,Swift storage

Nova --> Cinder

%%========================
%% MONITORING
%%========================

subgraph MON["📊 Monitoring"]

Prom["Prometheus"]

Node1["Exporter"]

Node2["Exporter"]

Node3["Exporter"]

end

Prom --> Node1
Prom --> Node2
Prom --> Node3

Node1 -.-> CTRL
Node2 -.-> C1
Node3 -.-> ST

class Prom,Node1,Node2,Node3 monitor

%%========================
%% FLOATING IP
%%========================

Floating["🌍 Floating IP Pool"]

Floating --> Router

Router --> VM1
Router --> VM2

class Floating provider

%%========================
%% MANAGEMENT
%%========================

subgraph MGMT["🟣 Management Network (10.0.0.0/24)"]

ControllerIP["Controller"]

Compute01["Compute01"]

Compute02["Compute02"]

StorageIP["Storage"]

MonitorIP["Monitor"]

end

ControllerIP -.SSH.-> Compute01
ControllerIP -.SSH.-> Compute02
ControllerIP -.SSH.-> StorageIP
ControllerIP -.SSH.-> MonitorIP

class ControllerIP,Compute01,Compute02,StorageIP,MonitorIP mgmt