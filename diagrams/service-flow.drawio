flowchart LR

%%====================================================
%% COLOR DEFINITIONS
%%====================================================

classDef user fill:#1565C0,color:#fff,stroke:#0D47A1,stroke-width:3px

classDef dashboard fill:#8E24AA,color:#fff,stroke:#4A148C,stroke-width:3px

classDef identity fill:#FB8C00,color:#fff,stroke:#E65100,stroke-width:3px

classDef compute fill:#43A047,color:#fff,stroke:#1B5E20,stroke-width:3px

classDef network fill:#E53935,color:#fff,stroke:#B71C1C,stroke-width:3px

classDef image fill:#FDD835,color:#000,stroke:#F9A825,stroke-width:3px

classDef storage fill:#6D4C41,color:#fff,stroke:#3E2723,stroke-width:3px

classDef messaging fill:#FF7043,color:#fff,stroke:#BF360C,stroke-width:3px

classDef database fill:#546E7A,color:#fff,stroke:#263238,stroke-width:3px

classDef vm fill:#26A69A,color:#fff,stroke:#00695C,stroke-width:3px

%%====================================================
%% USER
%%====================================================

User([👤 User])

Horizon["🎛 Horizon Dashboard"]

Keystone["🔐 Keystone"]

User --> Horizon
Horizon --> Keystone

class User user
class Horizon dashboard
class Keystone identity

%%====================================================
%% CONTROL PLANE
%%====================================================

subgraph ControlPlane["☁ OpenStack Control Plane"]

Nova["💻 Nova API"]

Placement["📍 Placement"]

Rabbit["📨 RabbitMQ"]

Glance["🖼 Glance"]

Neutron["🌐 Neutron"]

Cinder["💾 Cinder"]

Maria[(🗄 MariaDB)]

end

Keystone --> Nova

Nova --> Placement
Nova --> Rabbit
Nova --> Glance
Nova --> Neutron
Nova --> Cinder

Nova --> Maria
Glance --> Maria
Neutron --> Maria
Keystone --> Maria
Cinder --> Maria

class Nova,Placement compute
class Neutron network
class Glance image
class Cinder storage
class Rabbit messaging
class Maria database

%%====================================================
%% COMPUTE
%%====================================================

subgraph Compute["🖥 Compute Node"]

NovaCompute["Nova Compute"]

Libvirt["Libvirt"]

KVM["KVM"]

VM["Ubuntu Instance"]

NovaCompute --> Libvirt

Libvirt --> KVM

KVM --> VM

end

Rabbit --> NovaCompute
Placement --> NovaCompute

class NovaCompute,KVM compute
class VM vm

%%====================================================
%% NETWORK
%%====================================================

subgraph Networking["🌐 Networking"]

Router["Virtual Router"]

DHCP["DHCP Agent"]

Floating["Floating IP"]

end

Neutron --> Router

Router --> DHCP

Router --> Floating

Floating --> VM

class Router,DHCP,Floating network

%%====================================================
%% STORAGE
%%====================================================

subgraph Storage["💽 Storage"]

Volume["Cinder Volume"]

Swift["Swift"]

end

Cinder --> Volume

Glance --> Swift

Volume --> VM

class Volume,Swift storage

